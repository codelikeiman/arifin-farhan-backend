APP_NAME=CBT_APP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbt_db
DB_USERNAME=root
DB_PASSWORD=

# DATABASE_URL ini dipakai khusus oleh Prisma (gabungan dari variabel DB_* di atas)
DATABASE_URL="mysql://root:@127.0.0.1:3306/cbt_db"

JWT_SECRET=change_this_secret_key
JWT_EXPIRES_IN=1d

TIMEZONE=Asia/Jakarta

# ==== VERIFIKASI AKUN (demo lokal) ====
# Sistem verifikasi TIDAK menggunakan email. Kode verifikasi 6 digit dibuat otomatis
# oleh backend saat user (selain admin) mencoba login sebelum akunnya terverifikasi.
# Admin melihat kode tersebut di halaman User Management dan menyampaikannya secara
# manual (lisan/chat) ke user yang bersangkutan.
